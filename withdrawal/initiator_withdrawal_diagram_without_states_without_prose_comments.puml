group Transaction Approval
hnote over Boomlet #Lavender:  initiator_approval_nonce := random_bytes(32) \n withdrawal_id := tagged_sha256("Boomerang/withdrawal_id", canonical_encode(setup_instance_id, tx_id, \n boomlet_0_identity_pubkey, initiator_approval_nonce))
hnote over Boomlet #Lavender:  peer_0_tx_approval := TxApproval{ \n withdrawal_id: withdrawal_id, \n approval_nonce: initiator_approval_nonce, \n event_block_height: niso_0_event_block_height \n } \n peer_0_tx_approval_signed_by_boomlet_0 := sign_message(boomlet_0_identity_privkey, \n "Boomerang/withdrawal/tx_approval", peer_0_tx_approval) \n _peer_0_tx_approval_signed_by_boomlet_0_encrypted_by_boomlet_0_for_wt := cbc_cmac_encrypt(keys: \n channel_keys(boomlet_0_identity_privkey, "boomlet", wt_pubkey, "wt", sender_public_key: \n boomlet_0_identity_pubkey, receiver_public_key: wt_pubkey), context: \n canonical_encode("withdrawal_tx_approval", withdrawal_id), content: peer_0_tx_approval_signed_by_boomlet_0) \n psbt_encrypted_by_boomlet_0_for_boomlet_i := cbc_cmac_encrypt(keys: channel_keys(boomlet_0_identity_privkey, \n "boomlet", boomlet_i_identity_pubkey, "boomlet", sender_public_key: boomlet_0_identity_pubkey, \n receiver_public_key: boomlet_i_identity_pubkey), context: canonical_encode("withdrawal_psbt", withdrawal_id), \n content: psbt) [1 <= i <= 4] \n psbt_encrypted_collection := Collection<psbt_encrypted_by_boomlet_0_for_boomlet_i> [1 <= i <= 4]

