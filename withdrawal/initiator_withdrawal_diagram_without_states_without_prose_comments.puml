hnote over WT #Lavender:  peer_0_tx_approval_signed_by_boomlet_0 := cbc_cmac_decrypt(keys: \n channel_keys(wt_privkey, "wt", boomlet_0_identity_pubkey, "boomlet", sender_public_key: \n boomlet_0_identity_pubkey, receiver_public_key: wt_pubkey), context: \n canonical_encode("withdrawal_tx_approval", withdrawal_id), envelope: \n peer_0_tx_approval_signed_by_boomlet_0_encrypted_by_boomlet_0_for_wt)
