' Step 7
ST o-> Niso:  <b>WithdrawalStNisoMessage1 \n tx_id_with_nonce_signed_by_st_encrypted_by_st_for_boomlet_0

' Step 8
Niso o-> Boomlet:  <b>WithdrawalNisoBoomletMessage2 \n tx_id_with_nonce_signed_by_st_encrypted_by_st_for_boomlet_0
hnote over Boomlet #Lavender:  tx_id_with_nonce_signed_by_st := cbc_cmac_decrypt(keys: \n channel_keys(boomlet_0_identity_privkey, "boomlet", st_0_identity_pubkey, "st", sender_public_key: \n st_0_identity_pubkey, receiver_public_key: boomlet_0_identity_pubkey), context: \n canonical_encode("withdrawal_tx_review_approval"), envelope: \n tx_id_with_nonce_signed_by_st_encrypted_by_st_for_boomlet_0)
hnote over Boomlet #Pink:  <b>Freshness check \n Assert tx_id_with_nonce_signed_by_st.content == tx_id_with_nonce
end group
