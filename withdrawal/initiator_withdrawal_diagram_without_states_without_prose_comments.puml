hnote over Boomlet #Pink:  If reached_boomlets_collection[peer_i_id] != Null \n Assert prev_ping_i.reached_mystery_flag != 0
group duress_check [ if random_integer(1, DURESS_CHECK_INTERVAL_IN_BLOCKS) == 1]:
hnote over Boomlet #Lavender:  duress_check_space := DuressCheckSpace{space: random_permutation([1..193])} \n duress_check_nonce := random_bytes(32) \n duress_check_space_with_nonce := MessageWithNonce{ \n content: duress_check_space \n nonce: duress_check_nonce } \n store outstanding {duress_check_nonce, duress_check_space, phase} \n duress_check_space_with_nonce_encrypted_by_boomlet_0_for_st := cbc_cmac_encrypt(keys: \n channel_keys(boomlet_0_identity_privkey, "boomlet", st_0_identity_pubkey, "st", sender_public_key: \n boomlet_0_identity_pubkey, receiver_public_key: st_0_identity_pubkey), context: \n canonical_encode("withdrawal_duress_challenge"), content: duress_check_space_with_nonce)

' Step 52
Boomlet o-> Niso:  <b>WithdrawalBoomletNisoMessage6 \n duress_check_space_with_nonce_encrypted_by_boomlet_0_for_st

' Step 53
Niso o-> ST:  <b>WithdrawalNisoStMessage3 \n duress_check_space_with_nonce_encrypted_by_boomlet_0_for_st
hnote over ST #Lavender:  duress_check_space_with_nonce := cbc_cmac_decrypt(keys: \n channel_keys(st_0_identity_privkey, "st", boomlet_0_identity_pubkey, "boomlet", sender_public_key: \n boomlet_0_identity_pubkey, receiver_public_key: st_0_identity_pubkey), context: \n canonical_encode("withdrawal_duress_challenge"), envelope: \n duress_check_space_with_nonce_encrypted_by_boomlet_0_for_st) \n duress_check_space := duress_check_space_with_nonce.content \n duress_display_columns := independently_shuffle_with_index_maps(duress_check_space.space, columns=5)

' Step 54
ST o-> User:  <b>WithdrawalStOutput3 \n duress_display_columns
hnote over User #Lavender:  user_selection := select_one_from_each(duress_display_columns)

' Step 55
User o-> ST:  <b>WithdrawalStInput3 \n user_selection
hnote over ST #Lavender:  duress_signal_index := \n original_indices_from_display_selection(duress_display_columns, user_selection) \n duress_signal_index_with_nonce := MessageWithNonce{ \n content: duress_signal_index \n nonce: duress_check_space_with_nonce.nonce } \n duress_signal_index_with_nonce_encrypted_by_st_for_boomlet_0 := cbc_cmac_encrypt(keys: \n channel_keys(st_0_identity_privkey, "st", boomlet_0_identity_pubkey, "boomlet", sender_public_key: \n st_0_identity_pubkey, receiver_public_key: boomlet_0_identity_pubkey), context: \n canonical_encode("withdrawal_duress_response"), content: duress_signal_index_with_nonce)

' Step 56
ST o-> Niso:  <b>WithdrawalStNisoMessage3 \n duress_signal_index_with_nonce_encrypted_by_st_for_boomlet_0

' Step 57
Niso o-> Boomlet:  <b>WithdrawalNisoBoomletMessage7 \n duress_signal_index_with_nonce_encrypted_by_st_for_boomlet_0
hnote over Boomlet #Lavender:  duress_signal_index_with_nonce := cbc_cmac_decrypt(keys: \n channel_keys(boomlet_0_identity_privkey, "boomlet", st_0_identity_pubkey, "st", sender_public_key: \n st_0_identity_pubkey, receiver_public_key: boomlet_0_identity_pubkey), context: \n canonical_encode("withdrawal_duress_response"), envelope: \n duress_signal_index_with_nonce_encrypted_by_st_for_boomlet_0)
hnote over Boomlet #Pink:  <b>Freshness check \n Assert outstanding duress check exists for current phase \n Assert duress_signal_index_with_nonce.nonce == duress_check_nonce \n Assert count(duress_signal_index_with_nonce.content.indices) == 5 \n Assert duress_signal_index_with_nonce.content.indices are distinct \n Assert duress_signal_index_with_nonce.content.indices are in range [1..193]
hnote over Boomlet #Lavender:  consume outstanding duress check \n duress_signal := duress_check_space.space[duress_signal_index_with_nonce.content.indices] \n doxing_key_for_sar := tagged_sha256("Boomerang/doxing_key_for_sar", doxing_key || sar_pubkey_bytes) \n duress_placeholder_plaintext := Evaluate(duress_signal, duress_consent_set, doxing_key_for_sar) [either \n all-zero 32-byte padding or doxing_key_for_sar]
end group
hnote over Boomlet #Lavender:  duress_placeholder := cbc_cmac_encrypt(keys: \n channel_keys(boomlet_0_identity_privkey, "boomlet", sar_pubkey, "sar", sender_public_key: \n boomlet_0_identity_pubkey, receiver_public_key: sar_pubkey), context: \n canonical_encode("withdrawal_duress_placeholder", approved_withdrawal_id), content: \n duress_placeholder_plaintext)
hnote over Boomlet #Lavender:  counter_advance_allowed := niso_0_event_block_height > last_seen_block \n && forall peer_i [1 <= i <= 4]: prev_ping_i.last_seen_block >= (niso_0_event_block_height - \n TOLERANCE_IN_BLOCKS_FROM_CREATING_PING_BY_OTHER_PEERS_TO_REVIEWING_THE_PING_IN_PEER_BOOMLET) && \n prev_ping_i.last_seen_block <= niso_0_event_block_height
hnote over Boomlet #Lavender:  if reached_boomlets_collection[peer_i_id] == Null and \n prev_ping_i.reached_mystery_flag==1: \n reached_boomlets_collection[peer_i_id] := prev_ping_i_signed_by_boomlet_i
hnote over Boomlet #Lavender:  if counter_advance_allowed: counter += 1 \n if last_seen_block < niso_0_event_block_height: \n last_seen_block := min(niso_0_event_block_height, (last_seen_block + \n JUMP_IN_BLOCKS_IF_LAST_SEEN_BLOCK_LAGS_BEHIND_NISO_EVENT_BLOCK_HEIGHT_IN_BOOMLET))
hnote over Boomlet #Lavender:  if counter >= mystery: \n reached_mystery_flag := 1
hnote over Boomlet #Lavender:  _peer_0_ping := Ping{ \n approved_withdrawal_id: approved_withdrawal_id, \n last_seen_block: last_seen_block \n ping_seq_num: (ping_seq_num += 1) \n reached_mystery_flag: reached_mystery_flag} \n _peer_0_ping_signed_by_boomlet_0 := sign_message(boomlet_0_identity_privkey, "Boomerang/withdrawal/ping", \n _peer_0_ping) \n _peer_0_ping_signed_by_boomlet_0_padded := PaddedMessage{ \n content: _peer_0_ping_signed_by_boomlet_0, \n padding: duress_placeholder \n } \n _peer_0_ping_signed_by_boomlet_0_padded_signed_by_boomlet_0 := sign_message(boomlet_0_identity_privkey, \n "Boomerang/withdrawal/ping_envelope", _peer_0_ping_signed_by_boomlet_0_padded) \n peer_0_ping_signed_by_boomlet_0_padded_signed_by_boomlet_0_encrypted_by_boomlet_0_for_wt := \n cbc_cmac_encrypt(keys: channel_keys(boomlet_0_identity_privkey, "boomlet", wt_pubkey, "wt", sender_public_key: \n boomlet_0_identity_pubkey, receiver_public_key: wt_pubkey), context: canonical_encode("withdrawal_ping", \n approved_withdrawal_id), content: _peer_0_ping_signed_by_boomlet_0_padded_signed_by_boomlet_0)
end

' Step 58
Boomlet o-> Niso:  <b>WithdrawalBoomletNisoMessage7 \n peer_0_ping_signed_by_boomlet_0_padded_signed_by_boomlet_0_encrypted_by_boomlet_0_for_wt

' Step 59
Niso o-> WT:  <b>WithdrawalNisoWtMessage4 \n peer_0_ping_signed_by_boomlet_0_padded_signed_by_boomlet_0_encrypted_by_boomlet_0_for_wt
autonumber 59 "<b>[00]"

' Step 59 - b
Peers o-> WT:  peer_i_ping_signed_by_boomlet_i_padded_signed_by_boomlet_i_encrypted_by_boomlet_i_for_wt [1 <= \n i <= 4]
