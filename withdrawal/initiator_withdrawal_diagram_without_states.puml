hnote over ST #Lavender:  duress_check_space_with_nonce := cbc_cmac_decrypt(keys: channel_keys(st_0_identity_privkey, "st", boomlet_0_identity_pubkey, "boomlet", sender_public_key: boomlet_0_identity_pubkey, receiver_public_key: st_0_identity_pubkey), context: canonical_encode("withdrawal_duress_challenge"), envelope: duress_check_space_with_nonce_encrypted_by_boomlet_0_for_st) \n duress_check_space := duress_check_space_with_nonce.content \n duress_display_columns := independently_shuffle_with_index_maps(duress_check_space.space, columns=5)

