group duress_check [ if random_integer(1, DURESS_CHECK_INTERVAL_IN_BLOCKS) == 1]:
hnote over Boomlet #Lavender:  duress_check_space := DuressCheckSpace{space: random_permutation([1..193])} \n duress_check_nonce := random_bytes(32) \n duress_check_space_with_nonce := MessageWithNonce{\n content: duress_check_space \n nonce: duress_check_nonce } \n store outstanding {duress_check_nonce, duress_check_space, phase} \n duress_check_space_with_nonce_encrypted_by_boomlet_0_for_st := cbc_cmac_encrypt(keys: channel_keys(boomlet_0_identity_privkey, "boomlet", st_0_identity_pubkey, "st", sender_public_key: boomlet_0_identity_pubkey, receiver_public_key: st_0_identity_pubkey), context: canonical_encode("withdrawal_duress_challenge"), content: duress_check_space_with_nonce)

