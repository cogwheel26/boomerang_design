@startuml paired_consent_rotation
skinparam sequenceMessageAlign left
title Paired Consent Rotation Sequence Diagram

box "User Side" #AliceBlue
actor User order 1 #LightCyan
participant Niso order 2 #LightGreen
participant Boomlet order 3 #LightPink
participant ST order 4 #Violet
participant Boomletwo order 5 #LightGray
end box
participant WT order 98 #Red
participant SAR order 99 #Yellow

autonumber "<b>[00]"

hnote over Boomlet, Boomletwo #Lavender: At authenticated backup provisioning, Boomlet initializes \n consent_freshness_token := random_bytes(32); under_duress := false; consent_quarantined := false \n consent_rotation_state := Null \n Import these fields with the authenticated backup state; retain them across restart and rotation
hnote over Boomlet #Lavender: At provisioning: paired_reset_pending := false; withdrawal_resume_pending := false \n Each accepted withdrawal consent answer updates under_duress := under_duress OR (sort(duress_signal) != sort(duress_consent_set)) before output \n Rotation entry loads retained values

note over Boomlet, Boomletwo
Review = (setup_instance_id, backup_boomlet_pubkey, rotation_request_with_nonce)
Check = (consent_rotation_id, enrollment_round, input_step, space)
Answer = (consent_rotation_id, enrollment_round, input_step, selection)
UiResult = (consent_rotation_id, enrollment_round, result)
PendingConsentInput = (input_pending, enrollment_round, input_step, nonce, space)
Candidate = (consent_rotation_id, replacement_consent_set, under_duress)
Rotation variables refer to fields retained in consent_rotation_state.
Every send atomically persists its state updates and exact envelope before output; retries reuse retained bytes.
rotation_domain(op) := "Boomerang/consent_rotation/v1/" + op
rotation_context(op) := canonical_encode("consent_rotation_" + op, setup_instance_id)
st_rotation_context(op) := canonical_encode("consent_rotation_" + op)
country_op(input_step, kind) := ("previous" if input_step == 1 else "selection" if input_step == 2 else "confirmation_1" if input_step == 3 else "confirmation_2") + "_" + kind
control_seal(operation, content, sender_identity_privkey, directional_keys) := cbc_cmac_encrypt(directional_keys, rotation_context(operation), sign_message(sender_identity_privkey, rotation_domain(operation), content))
control_open(operation, envelope, sender_identity_pubkey, directional_keys) := { signed_message := cbc_cmac_decrypt(directional_keys, rotation_context(operation), envelope); assert verify_signature(sender_identity_pubkey, rotation_domain(operation), signed_message); return signed_message.content }
EH(envelope) := sha256(canonical_encode(envelope))
ConsentRotationPhase = 0 HOLD_WAIT, 1 HELD, 2 PREVIOUS_PENDING, 3 ENROLLING, 4 PREPARE_WAIT, 5 PREPARED, 6 COMMIT_WAIT, 7 COMPLETE, 8 ABORT_WAIT, 9 ABORTED
end note

hnote over Boomlet, Boomletwo #Lavender: Each endpoint derives directional keys locally as in setup \n boomlet_0_to_st_keys := channel_keys(boomlet_0_identity_privkey, "boomlet", st_0_identity_pubkey, "st", boomlet_0_identity_pubkey, st_0_identity_pubkey) \n st_to_boomlet_0_keys := channel_keys(st_0_identity_privkey, "st", boomlet_0_identity_pubkey, "boomlet", st_0_identity_pubkey, boomlet_0_identity_pubkey) \n boomlet_0_to_boomletwo_keys := channel_keys(boomlet_0_identity_privkey, "boomlet", boomletwo_Identity_pubkey, "boomletwo", boomlet_0_identity_pubkey, boomletwo_Identity_pubkey) \n boomletwo_to_boomlet_0_keys := channel_keys(boomletwo_Identity_privkey, "boomletwo", boomlet_0_identity_pubkey, "boomlet", boomletwo_Identity_pubkey, boomlet_0_identity_pubkey)

group Rotation authorization
User o-> Niso: magic: "consent_rotation_start"
Niso o-> Boomlet: <b>BEGIN_REVIEW \n ()
hnote over Boomlet #Lavender: withdrawal_checkpoint := current retained withdrawal state, or Null if idle \n active_withdrawal := (withdrawal_checkpoint != Null) \n withdrawal_phase := withdrawal_checkpoint.phase if active_withdrawal else IDLE
hnote over Boomlet #Pink: Assert no unresolved rotation, FINISH or teardown and ST available \n If active_withdrawal: assert withdrawal_phase in {DIGGING, READY_TO_SIGN, SIGNING, SIGNATURE_EXPORTED}
hnote over Boomlet #Lavender: consent_rotation_request_with_nonce := MessageWithNonce{content: consent_freshness_token, nonce: random_bytes(32)} \n consent_rotation_review := Review{setup_instance_id, boomletwo_Identity_pubkey, consent_rotation_request_with_nonce} \n pending_consent_rotation_review := consent_rotation_review \n Bind pending_consent_rotation_review to retained pair and current withdrawal identity \n consent_rotation_review_encrypted_by_boomlet_0_for_st := cbc_cmac_encrypt(boomlet_0_to_st_keys, st_rotation_context("review_challenge"), consent_rotation_review)
Boomlet o-> Niso: consent_rotation_review_encrypted_by_boomlet_0_for_st
Niso o-> ST: consent_rotation_review_encrypted_by_boomlet_0_for_st
hnote over ST #Lavender: consent_rotation_review := cbc_cmac_decrypt(boomlet_0_to_st_keys, st_rotation_context("review_challenge"), consent_rotation_review_encrypted_by_boomlet_0_for_st) \n setup_instance_id := consent_rotation_review.setup_instance_id \n boomletwo_Identity_pubkey := consent_rotation_review.backup_boomlet_pubkey \n consent_rotation_request_with_nonce := consent_rotation_review.rotation_request_with_nonce
hnote over ST #Pink: Authenticate review from paired boomlet_0_identity_pubkey
ST o-> User: magic: "approve_consent_rotation" \n setup_instance_id; boomlet_0_identity_pubkey; boomletwo_Identity_pubkey
User o-> ST: magic: "consent_rotation_approved"
hnote over ST #Lavender: consent_rotation_id := consent_rotation_request_with_nonce.nonce \n consent_rotation_request_with_nonce_signed_by_st := sign_message(st_0_identity_privkey, \n "Boomerang/consent_rotation/v1/st_review", consent_rotation_request_with_nonce) \n consent_rotation_request_with_nonce_signed_by_st_encrypted_by_st_for_boomlet_0 := cbc_cmac_encrypt(st_to_boomlet_0_keys, st_rotation_context("review_approval"), consent_rotation_request_with_nonce_signed_by_st) \n Retain consent_rotation_id durably for UI recovery
ST o-> Niso: consent_rotation_request_with_nonce_signed_by_st_encrypted_by_st_for_boomlet_0
Niso o-> Boomlet: <b>SUBMIT_REVIEW \n consent_rotation_request_with_nonce_signed_by_st_encrypted_by_st_for_boomlet_0
hnote over Boomlet #Lavender: consent_rotation_request_with_nonce_signed_by_st := cbc_cmac_decrypt(st_to_boomlet_0_keys, st_rotation_context("review_approval"), consent_rotation_request_with_nonce_signed_by_st_encrypted_by_st_for_boomlet_0)
hnote over Boomlet #Pink: Assert verify_signature(st_0_identity_pubkey, rotation_domain("st_review"), consent_rotation_request_with_nonce_signed_by_st) \n Assert consent_rotation_request_with_nonce_signed_by_st.content == pending_consent_rotation_review.rotation_request_with_nonce \n Assert retained pairing, pending freshness token and outstanding nonce match \n Assert current predecessor token, private withdrawal binding, eligible withdrawal_phase and storage capacity
hnote over Boomlet #Lavender: enrollment_round := 0; previous_set_checked := false; cancelled := false; result := 0 \n rotation_phase := 0; st_recovery_query_digests := [] \n consent_rotation_id := consent_rotation_request_with_nonce.nonce \n consent_freshness_token := consent_rotation_id; paired_reset_pending := true \n latest_st_challenge_nonce := consent_rotation_id; consent_quarantined := true \n withdrawal_checkpoint := latest retained withdrawal state, or Null if idle \n consent_rotation_state := {authorization: consent_rotation_request_with_nonce_signed_by_st, rotation_phase: 0, st_recovery_query_digests: [], st_recovery_reply: Null} \n Preserve mystery, counter, Ping sequence and signing history \n Retire unsent Pings, unconsumed withdrawal ST input and Pong progress \n Atomically persist checkpoint, pause, approval, consumed token, flag and quarantine
end group

group Hold both devices
hnote over Boomlet, Boomletwo #Pink: Bind control envelopes to setup_instance_id and retained pair keys \n Verify source signatures with boomlet_0_identity_pubkey and target signatures with boomletwo_Identity_pubkey \n Boomletwo uses its original key for target messages; while inactive, copied Boomlet key is restricted to SAR verification
hnote over Boomlet #Lavender: consent_rotation_hold := (consent_rotation_request_with_nonce_signed_by_st) \n consent_rotation_hold_signed_by_boomlet_0_encrypted_by_boomlet_0_for_boomletwo := control_seal("hold", consent_rotation_hold, boomlet_0_identity_privkey, boomlet_0_to_boomletwo_keys) \n Persist exact HOLD before sending
Boomlet o-> Niso: consent_rotation_hold_signed_by_boomlet_0_encrypted_by_boomlet_0_for_boomletwo
Niso o-> Boomletwo: consent_rotation_hold_signed_by_boomlet_0_encrypted_by_boomlet_0_for_boomletwo
hnote over Boomletwo #Lavender: consent_rotation_hold := control_open("hold", consent_rotation_hold_signed_by_boomlet_0_encrypted_by_boomlet_0_for_boomletwo, boomlet_0_identity_pubkey, boomlet_0_to_boomletwo_keys)
hnote over Boomletwo #Pink: Verify ST signature with retained st_0_identity_pubkey \n consent_rotation_id := consent_rotation_hold.authorization.content.nonce \n Assert inactive role \n New attempt requires consent_rotation_hold.authorization.content.content == consent_freshness_token and terminal previous rotation record \n Duplicates must match original approval
hnote over Boomletwo #Lavender: consent_freshness_token := consent_rotation_id \n consent_quarantined := true; rotation_phase := 1 \n consent_rotation_state := {authorization: consent_rotation_hold.authorization, rotation_phase: 1} \n consent_rotation_held := (consent_rotation_id, \n EH(consent_rotation_hold_signed_by_boomlet_0_encrypted_by_boomlet_0_for_boomletwo), under_duress) \n consent_rotation_held_signed_by_boomletwo_encrypted_by_boomletwo_for_boomlet_0 := control_seal("held", consent_rotation_held, boomletwo_Identity_privkey, boomletwo_to_boomlet_0_keys) \n Persist approval, consumed token, quarantine and activation hold
Boomletwo o-> Niso: consent_rotation_held_signed_by_boomletwo_encrypted_by_boomletwo_for_boomlet_0
Niso o-> Boomlet: consent_rotation_held_signed_by_boomletwo_encrypted_by_boomletwo_for_boomlet_0
hnote over Boomlet #Lavender: consent_rotation_held := control_open("held", consent_rotation_held_signed_by_boomletwo_encrypted_by_boomletwo_for_boomlet_0, boomletwo_Identity_pubkey, boomletwo_to_boomlet_0_keys)

alt HELD receipt verified
  hnote over Boomlet #Lavender: under_duress := under_duress OR consent_rotation_held.under_duress; rotation_phase := 1 \n Persist HELD receipt and flag

  group Check previous consent
  hnote over Boomlet #Lavender: enrollment_round := 0; input_step := 1; rotation_phase := 2 \n duress_check_space := DuressCheckSpace{space: random_permutation([1..193])} \n consent_rotation_country_challenge_with_nonce := MessageWithNonce{ \n content: Check{consent_rotation_id, enrollment_round, input_step, duress_check_space}, nonce: random_bytes(32)} \n latest_st_challenge_nonce := consent_rotation_country_challenge_with_nonce.nonce \n consent_rotation_country_challenge_with_nonce_encrypted_by_boomlet_0_for_st := cbc_cmac_encrypt(boomlet_0_to_st_keys, st_rotation_context(country_op(input_step, "challenge")), consent_rotation_country_challenge_with_nonce) \n Persist challenge before sending
  Boomlet o-> Niso: consent_rotation_country_challenge_with_nonce_encrypted_by_boomlet_0_for_st
  Niso o-> ST: consent_rotation_country_challenge_with_nonce_encrypted_by_boomlet_0_for_st
  hnote over ST #Lavender: consent_rotation_country_challenge_with_nonce := cbc_cmac_decrypt(boomlet_0_to_st_keys, st_rotation_context(country_op(input_step, "challenge")), consent_rotation_country_challenge_with_nonce_encrypted_by_boomlet_0_for_st) \n enrollment_round := consent_rotation_country_challenge_with_nonce.content.enrollment_round; input_step := consent_rotation_country_challenge_with_nonce.content.input_step \n duress_check_space := consent_rotation_country_challenge_with_nonce.content.space
  hnote over ST #Pink: Assert consent_rotation_country_challenge_with_nonce.content.consent_rotation_id == consent_rotation_id
  hnote over ST #Lavender: duress_display_columns, retained_display_maps := create_duress_display_columns(duress_check_space.space)
  ST o-> User: magic: "enter_previous_consent_set" \n duress_display_columns
  hnote over User #Lavender: user_selection := select_one_from_each(duress_display_columns)
  User o-> ST: user_selection
  hnote over ST #Lavender: duress_signal_index := map_to_original_indices(user_selection, retained_display_maps) \n consent_rotation_country_answer_with_nonce := MessageWithNonce{ \n content: Answer{consent_rotation_id, enrollment_round, input_step, duress_signal_index}, nonce: consent_rotation_country_challenge_with_nonce.nonce} \n consent_rotation_country_answer_with_nonce_encrypted_by_st_for_boomlet_0 := cbc_cmac_encrypt(st_to_boomlet_0_keys, st_rotation_context(country_op(input_step, "answer")), consent_rotation_country_answer_with_nonce)
  ST o-> Niso: consent_rotation_country_answer_with_nonce_encrypted_by_st_for_boomlet_0
  Niso o-> Boomlet: consent_rotation_country_answer_with_nonce_encrypted_by_st_for_boomlet_0
  hnote over Boomlet #Lavender: consent_rotation_country_answer_with_nonce := cbc_cmac_decrypt(st_to_boomlet_0_keys, st_rotation_context(country_op(input_step, "answer")), consent_rotation_country_answer_with_nonce_encrypted_by_st_for_boomlet_0) \n duress_signal_index := consent_rotation_country_answer_with_nonce.content.selection
  hnote over Boomlet #Pink: Assert consent_rotation_id, enrollment_round, input_step, outstanding nonce and five distinct valid indices
  hnote over Boomlet #Lavender: selected_consent_set := sort(duress_check_space.space[duress_signal_index.indices]) \n under_duress := under_duress OR (selected_consent_set != sort(duress_consent_set)) \n previous_set_checked := true \n consent_rotation_result_with_nonce := MessageWithNonce{ \n content: UiResult{consent_rotation_id, 0, 0}, nonce: consent_rotation_country_answer_with_nonce.nonce} \n consent_rotation_result_with_nonce_encrypted_by_boomlet_0_for_st := cbc_cmac_encrypt(boomlet_0_to_st_keys, st_rotation_context("previous_result"), consent_rotation_result_with_nonce) \n Atomically persist accepted answer, flag and cached result before replying
  Boomlet o-> Niso: consent_rotation_result_with_nonce_encrypted_by_boomlet_0_for_st
  Niso o-> ST: consent_rotation_result_with_nonce_encrypted_by_boomlet_0_for_st
  hnote over ST #Lavender: consent_rotation_result_with_nonce := cbc_cmac_decrypt(boomlet_0_to_st_keys, st_rotation_context("previous_result"), consent_rotation_result_with_nonce_encrypted_by_boomlet_0_for_st)
  end group

  group Enroll fresh consent
  loop enrollment_round = 1..3, until result == 2 or cancelled
    hnote over Boomlet #Lavender: rotation_phase := 3; confirmation_matches := {3: false, 4: false}
    loop input_step = 2 selection, 3 first confirmation, 4 second confirmation
      hnote over Boomlet #Lavender: duress_check_space := DuressCheckSpace{space: random_permutation([1..193])} \n consent_rotation_country_challenge_with_nonce := MessageWithNonce{ \n content: Check{consent_rotation_id, enrollment_round, input_step, duress_check_space}, nonce: random_bytes(32)} \n latest_st_challenge_nonce := consent_rotation_country_challenge_with_nonce.nonce \n consent_rotation_country_challenge_with_nonce_encrypted_by_boomlet_0_for_st := cbc_cmac_encrypt(boomlet_0_to_st_keys, st_rotation_context(country_op(input_step, "challenge")), consent_rotation_country_challenge_with_nonce) \n Persist challenge before sending
      Boomlet o-> Niso: consent_rotation_country_challenge_with_nonce_encrypted_by_boomlet_0_for_st
      Niso o-> ST: consent_rotation_country_challenge_with_nonce_encrypted_by_boomlet_0_for_st
      hnote over ST #Lavender: consent_rotation_country_challenge_with_nonce := cbc_cmac_decrypt(boomlet_0_to_st_keys, st_rotation_context(country_op(input_step, "challenge")), consent_rotation_country_challenge_with_nonce_encrypted_by_boomlet_0_for_st) \n enrollment_round := consent_rotation_country_challenge_with_nonce.content.enrollment_round; input_step := consent_rotation_country_challenge_with_nonce.content.input_step \n duress_check_space := consent_rotation_country_challenge_with_nonce.content.space
      hnote over ST #Pink: Assert consent_rotation_country_challenge_with_nonce.content.consent_rotation_id == consent_rotation_id
      hnote over ST #Lavender: duress_display_columns, retained_display_maps := create_duress_display_columns(duress_check_space.space) \n consent_prompt := "choose_fresh_consent_set" if input_step = 2 else "confirm_fresh_consent_set"
      ST o-> User: magic: consent_prompt \n duress_display_columns
      hnote over User #Lavender: user_selection := select_one_from_each(duress_display_columns)
      User o-> ST: user_selection
      hnote over ST #Lavender: duress_signal_index := map_to_original_indices(user_selection, retained_display_maps) \n consent_rotation_country_answer_with_nonce := MessageWithNonce{ \n content: Answer{consent_rotation_id, enrollment_round, input_step, duress_signal_index}, nonce: consent_rotation_country_challenge_with_nonce.nonce} \n consent_rotation_country_answer_with_nonce_encrypted_by_st_for_boomlet_0 := cbc_cmac_encrypt(st_to_boomlet_0_keys, st_rotation_context(country_op(input_step, "answer")), consent_rotation_country_answer_with_nonce)
      ST o-> Niso: consent_rotation_country_answer_with_nonce_encrypted_by_st_for_boomlet_0
      Niso o-> Boomlet: consent_rotation_country_answer_with_nonce_encrypted_by_st_for_boomlet_0
      hnote over Boomlet #Lavender: consent_rotation_country_answer_with_nonce := cbc_cmac_decrypt(st_to_boomlet_0_keys, st_rotation_context(country_op(input_step, "answer")), consent_rotation_country_answer_with_nonce_encrypted_by_st_for_boomlet_0) \n duress_signal_index := consent_rotation_country_answer_with_nonce.content.selection
      hnote over Boomlet #Pink: Assert consent_rotation_id, enrollment_round, input_step, outstanding nonce and five distinct valid indices
      hnote over Boomlet #Lavender: selected_consent_set := sort(duress_check_space.space[duress_signal_index.indices]) \n input_step = 2: replacement_consent_set := selected_consent_set \n input_step = 3, 4: confirmation_matches[input_step] := (selected_consent_set == replacement_consent_set) \n Atomically consume answer and persist next challenge or result
    end
    hnote over Boomlet #Lavender: result := 2 READY if confirmation_matches[3] and confirmation_matches[4] and replacement_consent_set != duress_consent_set, else 1 RETRY \n consent_rotation_result_with_nonce := MessageWithNonce{ \n content: UiResult{consent_rotation_id, enrollment_round, result}, nonce: consent_rotation_country_answer_with_nonce.nonce} \n consent_rotation_result_with_nonce_encrypted_by_boomlet_0_for_st := cbc_cmac_encrypt(boomlet_0_to_st_keys, st_rotation_context("round_result"), consent_rotation_result_with_nonce)
    Boomlet o-> Niso: consent_rotation_result_with_nonce_encrypted_by_boomlet_0_for_st
    Niso o-> ST: consent_rotation_result_with_nonce_encrypted_by_boomlet_0_for_st
    hnote over ST #Lavender: consent_rotation_result_with_nonce := cbc_cmac_decrypt(boomlet_0_to_st_keys, st_rotation_context("round_result"), consent_rotation_result_with_nonce_encrypted_by_boomlet_0_for_st)
  end
  end group

  opt User cancellation at any stage before COMMIT
    User o-> Niso: magic: "consent_rotation_cancel"
    Niso o-> Boomlet: <b>REQUEST_CANCEL \n ()
    hnote over Boomlet #Lavender: Retire pending country challenge; preserve accepted duress \n consent_rotation_cancel_with_nonce := MessageWithNonce{content: consent_rotation_id, nonce: random_bytes(32)} \n latest_st_challenge_nonce := consent_rotation_cancel_with_nonce.nonce \n consent_rotation_cancel_with_nonce_encrypted_by_boomlet_0_for_st := cbc_cmac_encrypt(boomlet_0_to_st_keys, st_rotation_context("cancel_challenge"), consent_rotation_cancel_with_nonce) \n Persist cancellation challenge
    Boomlet o-> Niso: consent_rotation_cancel_with_nonce_encrypted_by_boomlet_0_for_st
    Niso o-> ST: consent_rotation_cancel_with_nonce_encrypted_by_boomlet_0_for_st
    hnote over ST #Lavender: consent_rotation_cancel_with_nonce := cbc_cmac_decrypt(boomlet_0_to_st_keys, st_rotation_context("cancel_challenge"), consent_rotation_cancel_with_nonce_encrypted_by_boomlet_0_for_st)
    ST o-> User: magic: "confirm_consent_rotation_cancellation"
    User o-> ST: magic: "consent_rotation_cancellation_approved"
    hnote over ST #Lavender: consent_rotation_cancel_with_nonce_signed_by_st := sign_message(st_0_identity_privkey, \n "Boomerang/consent_rotation/v1/st_cancel", consent_rotation_cancel_with_nonce) \n consent_rotation_cancel_with_nonce_signed_by_st_encrypted_by_st_for_boomlet_0 := cbc_cmac_encrypt(st_to_boomlet_0_keys, st_rotation_context("cancel_approval"), consent_rotation_cancel_with_nonce_signed_by_st)
    ST o-> Niso: consent_rotation_cancel_with_nonce_signed_by_st_encrypted_by_st_for_boomlet_0
    Niso o-> Boomlet: consent_rotation_cancel_with_nonce_signed_by_st_encrypted_by_st_for_boomlet_0
    hnote over Boomlet #Lavender: consent_rotation_cancel_with_nonce_signed_by_st := cbc_cmac_decrypt(st_to_boomlet_0_keys, st_rotation_context("cancel_approval"), consent_rotation_cancel_with_nonce_signed_by_st_encrypted_by_st_for_boomlet_0)
    hnote over Boomlet #Pink: Assert signed cancellation matches outstanding consent_rotation_id and challenge nonce \n cancelled := true; persist cancellation
  end

  opt result == 2 and not cancelled
    hnote over Boomlet #Lavender: consent_rotation_candidate := Candidate{consent_rotation_id, replacement_consent_set, under_duress} \n consent_rotation_prepare := (consent_rotation_candidate) \n rotation_phase := 4 \n consent_rotation_prepare_signed_by_boomlet_0_encrypted_by_boomlet_0_for_boomletwo := control_seal("prepare", consent_rotation_prepare, boomlet_0_identity_privkey, boomlet_0_to_boomletwo_keys) \n Persist completed previous check, candidate and PREPARE before sending
    Boomlet o-> Niso: consent_rotation_prepare_signed_by_boomlet_0_encrypted_by_boomlet_0_for_boomletwo
    Niso o-> Boomletwo: consent_rotation_prepare_signed_by_boomlet_0_encrypted_by_boomlet_0_for_boomletwo
    hnote over Boomletwo #Lavender: consent_rotation_prepare := control_open("prepare", consent_rotation_prepare_signed_by_boomlet_0_encrypted_by_boomlet_0_for_boomletwo, boomlet_0_identity_pubkey, boomlet_0_to_boomletwo_keys) \n consent_rotation_candidate := consent_rotation_prepare.candidate
    hnote over Boomletwo #Pink: Assert HELD rotation phase, admitted consent_rotation_id, valid replacement different from current set and source signature under boomlet_0_identity_pubkey \n PREPARE closes country input; prepared candidate remains immutable until COMMIT or ABORT
    hnote over Boomletwo #Lavender: under_duress := under_duress OR consent_rotation_candidate.under_duress \n consent_rotation_candidate.under_duress := under_duress \n consent_rotation_prepared := (consent_rotation_id, \n EH(consent_rotation_prepare_signed_by_boomlet_0_encrypted_by_boomlet_0_for_boomletwo), under_duress) \n rotation_phase := 5 \n consent_rotation_prepared_signed_by_boomletwo_encrypted_by_boomletwo_for_boomlet_0 := control_seal("prepared", consent_rotation_prepared, boomletwo_Identity_privkey, boomletwo_to_boomlet_0_keys) \n Durably persist flag, prepared candidate and receipt
    Boomletwo o-> Niso: consent_rotation_prepared_signed_by_boomletwo_encrypted_by_boomletwo_for_boomlet_0
    Niso o-> Boomlet: consent_rotation_prepared_signed_by_boomletwo_encrypted_by_boomletwo_for_boomlet_0
    hnote over Boomlet #Lavender: consent_rotation_prepared := control_open("prepared", consent_rotation_prepared_signed_by_boomletwo_encrypted_by_boomletwo_for_boomlet_0, boomletwo_Identity_pubkey, boomletwo_to_boomlet_0_keys)
    hnote over Boomlet #Pink: Assert consent_rotation_prepared.consent_rotation_id == consent_rotation_id \n Assert consent_rotation_prepared.request_digest == EH(consent_rotation_prepare_signed_by_boomlet_0_encrypted_by_boomlet_0_for_boomletwo) \n Assert not consent_rotation_candidate.under_duress or consent_rotation_prepared.under_duress
